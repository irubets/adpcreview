    shinyWidgets,
    shinyFiles,
    DT,
    plotly,
    ggplot2,
    dplyr,
    tidyr,
    haven,
    readr,
    openxlsx,
    stringr,
    purrr,
    scales,
    httr2,
    jsonlite,
    htmltools,
    PKNCA,
    zip,
    digest
ByteCompile: true
NeedsCompilation: no
URL: https://github.com/irubets/adpcreview
BugReports: https://github.com/irubets/adpcreview/issues
