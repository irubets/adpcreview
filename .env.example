# Copy required values to .Renviron or another local environment file.
# Never place real credentials in this committed template.

# Local Qwen through Ollama
LLM_ENABLED=false
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:4b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=2400

# OpenAI
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=1200

# Anthropic
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_OUTPUT_TOKENS=1600
